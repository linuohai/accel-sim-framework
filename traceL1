    echo "  --plot-backend <session|local>  选择绘图后端 (默认: local)"
    echo "  --plot-background      local 后端并行绘图并后台 detach（写日志后立即返回）"
    echo "  --plot-format <svg|png|both>  绘图输出格式 (默认: svg；png/both 可能需要 matplotlib+numpy)"
